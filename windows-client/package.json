
{
  "name": "pisonet-windows-client",
  "version": "0.1.0",
  "description": "PisoNet Cloud Windows Client",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 5174 --strictPort\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "dotenv": "^18.0.9",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^26.18.0",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.pisonetcloud.client",
    "productName": "PisoNet Cloud",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
  "dist/**/*",
  "electron/**/*",
  "package.json"
],
"asarUnpack": [
  "electron/*.ps1"
],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PisoNet-Cloud-Setup-${version}.${ext}"
    },
    
"nsis": {
  "oneClick": false,
  "perMachine": true,
  "allowToChangeInstallationDirectory": false,
  "createDesktopShortcut": true,
  "createStartMenuShortcut": true,
  "shortcutName": "PisoNet Cloud",
  "runAfterFinish": false
}

  }
}
